{
  "name": "@webtre/nestjs-mailer-react-adapter",
  "version": "0.2.5",
  "description": "Build and send emails in Nest framework using React.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:types": "node scripts/verify-types.mjs",
    "prepack": "npm run build && npm run verify:build && npm run verify:types && npm test",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webtretech/nestjs-mailer-react-adapter.git"
  },
  "author": "Lawrence Onah <paplow01@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webtretech/nestjs-mailer-react-adapter/issues"
  },
  "homepage": "https://github.com/webtretech/nestjs-mailer-react-adapter#readme",
  "dependencies": {
    "@react-email/render": "^2.3.0"
  },
  "peerDependencies": {
    "@nestjs-modules/mailer": "^2.0.1 || ^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs-modules/mailer": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "nestjs",
    "mailer",
    "module",
    "email",
    "nodemailer",
    "nodejs",
    "mail",
    "nest",
    "reactjs",
    "nestjs-mailer",
    "node",
    "react",
    "mailer-module",
    "adapter"
  ]
}
